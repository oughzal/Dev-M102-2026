algorithme exercice8

variables
    T : tableau[10] de entier
    N,i,nb,c : entier

debut
    T = [1,3,5,1,3,8,7,1,5,10]
    N = 10
    ecrire("donner un nombre : ")
    lire(nb)
    ecrireln(T)
    c = 0 
    pour i de 0 à N-1 faire
        si T[i]==nb alors
            c = c + 1
        finsi
    finpour
    ecrireln(nb, " est répété ",c , " fois")
fin