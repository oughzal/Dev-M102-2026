algorithme exercice3

variables
    n,p,m,i : entier

debut
    i=1
    repeter
        ecrire("donner un nombre : ")
        lire(n) # n = 80
        si i==1 ou m < n  alors
            m = n # m = 80
            p= i # p = 5 
        finsi  
        i = i + 1   # i = 5
    jusqua n==0
    ecrire("le max est ", m , " est ça position est ",p)
fin