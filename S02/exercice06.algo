algorithme exercice6

variables
    m : entier

debut
    ecrire("donner le N° du mois : ")
    lire(m)

    si m==1 alors
        ecrireln("Janvier")
    sinonSi m==2 alors
        ecrireln("Fevrier")
    sinonSi m==3 alors
        ecrireln("Mars")
    sinonSi m==4 alors
        ecrireln("Avril")
    sinonSi m==5 alors
        ecrireln("Mai")
    sinonSi m==6 alors
        ecrireln("Juin")
    sinonSi m==7 alors
        ecrireln("Juillet")
    sinonSi m==8 alors
        ecrireln("Aout")
    sinonSi m==9 alors
        ecrireln("Septembre")
    sinonSi m==10 alors
        ecrireln("Octobre")
    sinonSi m==11 alors
        ecrireln("Novembre")
    sinonSi m==12 alors
        ecrireln("Décembre")
    sinon
        ecrireln("N° du mois incorrect")
    finSi

    selon (m)
     cas 1 : ecrireln("Janvier")
     cas 2 : ecrireln("Fevrier")
     cas 3 : ecrireln("Mars")
     cas 4 : ecrireln("Avril")
     cas 5 : ecrireln("Mai")
     cas 6 : ecrireln("Juin")
     cas 7 : ecrireln("Juillet")
     cas 8 : ecrireln("Aout")
     cas 9 : ecrireln("Septembre")
     cas 10 : ecrireln("Octobre")
     cas 11 : ecrireln("Novembre")
     cas 12 : ecrireln("Décembre")
     defaut : ecrireln("N° invalide")
finSelon
    
fin